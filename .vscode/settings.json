{
    "intelephense.files.exclude": [
        "**/vendor/composer/**",
        "**/vendor/squizlabs/**",
        "**/vendor/pheromone/phpcs-security-audit/**",
        "**/vendor/**/tests/**",
        "**/vendor/**/test/**",
        "**/node_modules/**",
        "**/tcpdf/**"
    ],
    "files.watcherExclude": {
